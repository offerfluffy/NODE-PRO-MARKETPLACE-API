# Port HTTP-server
PORT=21100
# Full URL connection to PG
DB_URL=postgres://app_user@127.0.0.1:21120/shop
# Path to the file containing the PostgreSQL application password
DB_PASSWORD_FILE=secrets/db_password
# TypeORM connection used by migrations, seed, demos, and reports
DB_HOST=127.0.0.1
DB_PORT=21110
DB_USER=admin
DB_PASSWORD=admin_bootstrap
DB_NAME=shop
# Log level: debug | info | warn | error. Optional, default info
LOG_LEVEL=info
# Timeout of external calls. Optional, default 5000
TIMEOUT_MS=5000
