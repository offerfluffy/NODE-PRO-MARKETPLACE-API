# Port HTTP-server
NODE_ENV=development
PORT=3000
# Full URL connection to PG
DB_URL=postgres://app_user@127.0.0.1:21120/shop
# Path to the file containing the PostgreSQL application password
DB_PASSWORD_FILE=secrets/db_password
# RabbitMQ connection; the real value comes from the secret store
BROKER_URL=amqp://app:app@127.0.0.1:21140
# ES256 keys are base64-encoded PEM values supplied by the secret store
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
# HMAC pepper for hashing opaque refresh tokens; supplied by the secret store
REFRESH_TOKEN_PEPPER=
# Evictable cache Redis
REDIS_URL=redis://127.0.0.1:21150
# Durable Redis for BullMQ, sessions, and rate-limit state
REDIS_QUEUE_URL=redis://127.0.0.1:21160
# TypeORM connection used by migrations, seed, demos, and reports
DB_HOST=127.0.0.1
DB_PORT=21110
DB_USER=admin
DB_PASSWORD=admin_bootstrap
DB_NAME=shop
# Log level: debug | info | warn | error. Optional, default info
LOG_LEVEL=info
# Timeout of external calls. Optional, default 5000
TIMEOUT_MS=5000
