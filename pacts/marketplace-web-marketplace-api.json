{
  "consumer": {
    "name": "marketplace-web"
  },
  "interactions": [
    {
      "description": "a request for order 1",
      "providerStates": [
        {
          "name": "order with id 1 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/orders/1"
      },
      "response": {
        "body": {
          "customer_id": "3",
          "id": "1",
          "items": [
            {
              "price_cents": 12900,
              "product_id": "1",
              "quantity": 1
            },
            {
              "price_cents": 5900,
              "product_id": "2",
              "quantity": 2
            }
          ],
          "status": "pending",
          "total_cents": 24700
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.7",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "marketplace-api"
  }
}